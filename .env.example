# Role: all | api | worker
HUXIO_ROLE=all
HUXIO_POOLS=default
HUXIO_PORT=8080
HUXIO_LOG_LEVEL=info

# Postgres: either a full DSN, or the parts below.
HUXIO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/huxio?sslmode=disable

# Seals endpoint signing secrets at rest. Generate with: huxio keygen
# Comma-separated for rotation: new key first, previous keys after.
HUXIO_ENCRYPTION_KEY=

# API auth. Org tokens are minted with: huxio jwt generate <org_id>
HUXIO_JWT_SECRET=
HUXIO_JWT_ALGORITHM=HS256
HUXIO_JWT_ISSUER=huxio
HUXIO_PORTAL_BASE_URL=http://localhost:8080

# Signature headers: standard (webhook-*) or huxio (huxio-*).
HUXIO_COMPAT_HEADERS=standard

# Delivery engine.
HUXIO_WORKER_REQUEST_TIMEOUT=30s
HUXIO_WORKER_MAX_INFLIGHT=2000
HUXIO_CLAIM_BATCH_SIZE=100
# A delivery waits this long for a slot in its endpoint's lane before the task
# goes back to the queue, and the task then stays invisible for the delay.
HUXIO_LANE_WAIT_TIMEOUT=2s
HUXIO_LANE_REQUEUE_DELAY=1s
# Attempts are batched into one COPY per flush. They are written after the
# delivery, so the interval adds nothing to delivery latency.
HUXIO_ATTEMPT_WRITER_FLUSH_INTERVAL=20ms
# The payload a fan-out loads is kept in process for the deliveries that
# follow it, so ten endpoints cost one payload read rather than eleven.
# 0 disables the cache.
HUXIO_PAYLOAD_CACHE_MAX_BYTES=67108864
HUXIO_PAYLOAD_CACHE_TTL=30s

# SSRF guard: extra CIDRs to allow (default blocks loopback/private/link-local).
HUXIO_ALLOW_SUBNETS=
